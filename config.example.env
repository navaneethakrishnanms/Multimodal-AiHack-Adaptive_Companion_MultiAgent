# Study Companion — LLM configuration
# Copy to `.env` and fill in. Any OpenAI-compatible endpoint works.

# Example (OpenAI):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Example (local llama.cpp / vLLM / Ollama):
# LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_API_KEY=local
# LLM_MODEL=your-model

# Optional: extra headers as JSON (some gateways require routing headers)
# LLM_EXTRA_HEADERS={"x-opencode-session": "study-companion"}
