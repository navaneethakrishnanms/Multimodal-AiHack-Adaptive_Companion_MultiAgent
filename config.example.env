# Study Companion — configuration. Copy to `.env` and fill in. `.env` is git-ignored; never commit keys.
# Any OpenAI-compatible endpoint works. With no working model the app runs in offline mode.

# --- OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# --- or OpenRouter (one key, many models; free models end in :free)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=google/gemini-2.5-flash

# --- or a local server (llama.cpp / vLLM / Ollama)
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=local
# LLM_MODEL=llama3.1

# Optional second models (default: LLM_MODEL)
# VERIFY_MODEL=gpt-4.1-mini     # re-solves generated quiz questions: cross-model validation
# VISION_MODEL=gpt-4o-mini      # describes figures in PDFs/slides

# Optional
# LLM_EXTRA_HEADERS={"x-routing": "study-companion"}
# WHISPER_MODEL=base            # tiny | base | small | medium (faster-whisper)
# WHISPER_DEVICE=auto           # set to cpu to skip CUDA
# RETRIEVAL_MIN_SCORE=0.14      # override the calibrated refusal gate (core/gate.json)
# PORT=7861
